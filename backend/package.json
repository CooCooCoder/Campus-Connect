{
  "name": "campusconnect-backend",
  "version": "1.0.0",
  "description": "CampusConnect: Campus Event & Club Management Portal Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "campusconnect",
    "events",
    "clubs",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "Shivamsh Anil Menon",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "docx": "^9.14.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.12.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "prisma": "^6.4.1",
    "puppeteer": "^25.16.0"
  }
}
