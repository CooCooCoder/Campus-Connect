# CampusConnect Root Environment Configuration Example

# Backend Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
# Hosted/Local PostgreSQL alternative:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/campusconnect?schema=public"

# MongoDB Extension Configuration
MONGODB_URI="mongodb://localhost:27017/campusconnect_logs"

# Frontend Configuration (Vite)
VITE_API_BASE_URL="http://localhost:5000/api"
